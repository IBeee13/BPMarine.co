<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ─── Cache aset statis ────────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp        "access plus 1 year"
    ExpiresByType image/jpeg        "access plus 1 year"
    ExpiresByType image/png         "access plus 1 year"
    ExpiresByType image/svg+xml     "access plus 1 year"
    ExpiresByType text/css          "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2        "access plus 1 year"
    ExpiresByType font/woff         "access plus 1 year"
</IfModule>

# ─── Headers: Cache-Control + Security ───────────────────────────────────────
<IfModule mod_headers.c>

    # Aset statis — cache 1 tahun, immutable
    <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # JS/CSS dari Vite sudah pakai hash di nama file — aman immutable
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML — jangan di-cache agar selalu fresh
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    # ── Security Headers ──────────────────────────────────────────────────────

    # Cegah MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Cegah clickjacking — sudah ada tapi pindah ke CSP jika pakai frame
    Header always set X-Frame-Options "SAMEORIGIN"

    # Paksa HTTPS selama 1 tahun (aktifkan HANYA setelah SSL terpasang)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Referrer policy — batasi info yang dikirim ke third-party
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy — nonaktifkan fitur browser yang tidak dipakai
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Content Security Policy — sesuaikan dengan domain kamu
    # Uncomment dan sesuaikan setelah site live di HTTPS
    # Header always set Content-Security-Policy "default-src 'self'; \
    #   script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; \
    #   style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; \
    #   font-src 'self' https://fonts.gstatic.com; \
    #   img-src 'self' data: https:; \
    #   connect-src 'self';"

</IfModule>

# ─── Kompresi: Brotli (prioritas) + Gzip (fallback) ─────────────────────────
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS \
        text/html text/plain text/css text/javascript \
        application/javascript application/json \
        image/svg+xml font/woff2
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE \
        text/html text/plain text/css text/javascript \
        application/javascript application/json \
        image/svg+xml font/woff2
</IfModule>

# ─── Blokir akses ke file sensitif ───────────────────────────────────────────
<FilesMatch "(^\.env|composer\.(json|lock)|package\.json|webpack\.mix\.js)$">
    Order allow,deny
    Deny from all
</FilesMatch>